{
  "name": "daily-news-briefing",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.server.json && tsc -b && vite build",
    "briefing:generate": "node --import tsx server/generate.ts",
    "diagnostics:evaluate": "node --import tsx server/evaluate.ts",
    "test": "node --import tsx --test server/*.test.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-sc": "^5.2.8",
    "dotenv": "^17.4.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "rss-parser": "^3.13.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.4",
    "tsx": "^4.23.12",
    "typescript": "~5.9.2",
    "vite": "^7.1.7"
  }
}
